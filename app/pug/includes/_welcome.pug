//- Приветствие в правой области (только десктоп)
section.h-100.d-flex.flex-column.align-items-center.justify-content-center.text-center
  img.avatar.avatar-lg.mb-4(src=me.avatar alt="Аватар: " + me.name width="200" height="200")
  h2.fs-6.fw-normal.lh-base.mb-0 Привет, #{me.shortName}
  p.contact-status.text-muted Выбери чат, чтобы начать общаться
